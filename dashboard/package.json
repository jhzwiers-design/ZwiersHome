{
  "name": "zwiers-home-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zwiers Home: custom smart-home dashboard (Milestone 1 prototype, sample data only)",
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "preview": "vite preview",
    "home": "vite build && vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
