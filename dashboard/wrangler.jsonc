// Cloudflare deployment settings (Workers static assets).
// Cloudflare builds with `npm run build` and serves the dist/ folder.
// No server code and no secrets: the prototype is static files only.
{
  "name": "zwiers-home",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
